# 루트 .env 템플릿 — 실제 값을 채워 .env로 복사해서 사용 (.env는 git 무시됨)
# docker compose가 이 파일 하나를 읽어 모든 컨테이너에 값을 넣어준다.
# (컨테이너 없이 backend를 직접 돌릴 때도 spring-dotenv가 같은 파일을 읽는다)

# ===== Database =====
# DB_URL은 로컬에선 비워둔다. 실행 방식마다 맞는 주소가 다른데, 양쪽 다 기본값이 있다.
#   컨테이너로 실행  → docker-compose.yml의 기본값 postgres:5432
#   호스트에서 직접   → application.yml의 기본값 localhost:5432
# 한 파일에 한 값만 적을 수 있어서, 여기에 적으면 둘 중 하나는 반드시 틀린 주소를 받는다.
# 배포(RDS)에서만 아래 주석을 풀어 엔드포인트를 넣는다 — 그때는 이 값이 기본값을 이긴다.
#DB_URL=jdbc:postgresql://soksak-db.xxxxx.ap-northeast-2.rds.amazonaws.com:5432/soksak
DB_USERNAME=postgres
# Postgres 비밀번호. 예: openssl rand -hex 32
DB_PASSWORD=

# ===== JWT =====
# 토큰 서명 키(HS256, 충분히 길게). 예: openssl rand -base64 32
JWT_SECRET_KEY=

# ===== 백엔드 → ai-server 내부 인증 =====
# 두 컨테이너가 같은 값을 봐야 한다(compose가 양쪽에 넣어준다).
# 예: openssl rand -hex 32
INTERNAL_AUTH_SECRET=

# ===== LLM (제공사 네이티브 SDK 직결) =====
# 예전엔 Vercel AI Gateway 한 곳을 거쳤지만(키 1개 + base_url 1개), 크레딧이 끊겨
# 제공사 직결로 옮겼다. 그래서 채팅 키는 따로 두지 않는다 —
# 아래 "토큰 수 세기" 절의 ANTHROPIC_API_KEY / GOOGLE_API_KEY 를 채팅에도 그대로 쓴다.
# 카탈로그에 Claude만 있으면 GOOGLE_API_KEY는, Gemini만 있으면 ANTHROPIC_API_KEY는
# 채팅엔 안 쓰이지만, 토큰 세기가 Anthropic 키를 쓰므로 그쪽은 어차피 필요하다.

# 요약 전용 모델/타임아웃. 둘 다 비워두면 코드 기본값(claude-haiku-4.5, 60초)이 쓰인다.
# 요약은 대화 전송 때 답변 생성 '앞'에서 도니 싸고 빠른 모델을 쓴다 — 여기가 느리면
# 그만큼 답변 첫 토큰이 늦는다. 그래서 타임아웃도 채팅(60초)보다 짧게 잡는 걸 권장.
SUMMARY_MODEL=
SUMMARY_TIMEOUT=20

# ===== 토큰 수 세기 (벤더 직결) =====
# 요약을 저장할 때 그 요약이 몇 토큰인지 세어 두려는 용도. 세어 둔 값으로 "어느 청크까지
# 프롬프트에 실을지"를 정하므로, 매 턴 다시 세지 않아도 되게 생성 시점에 한 번만 부른다.
# count_tokens 자체는 무료고 채팅과 레이트 리밋도 별개다.
#
# 필수. Anthropic /v1/messages/count_tokens 용이자, anthropic/* 모델의 채팅 키다.
ANTHROPIC_API_KEY=
# 사실상 필수 — 채팅 기본 모델이 google/*라 비우면 ai-server가 기동에 실패한다.
GOOGLE_API_KEY=

# 기준 토크나이저로 쓸 모델. 비워두면 코드 기본값(claude-opus-4-8).
# 카탈로그에서 토큰을 가장 많이 먹는 모델 하나로만 세어 두고 모든 방에 그 값을 쓴다.
# 다른 모델에선 실제보다 넉넉하게 잡히는데(= 과대추정), 컨텍스트가 터지는 쪽보다
# 조금 남기는 쪽이 안전해서 일부러 그렇게 둔다.
# 주의: 카탈로그 slug(anthropic/claude-opus-4.8)가 아니라 Anthropic 직접 ID 표기다.
TOKEN_COUNT_MODEL=

# ===== 이미지 모더레이션 (백엔드 → OpenAI) =====
# 캐릭터 이미지를 저장하기 '전'에 OpenAI omni-moderation으로 검사한다. 엔드포인트 자체는 무료지만
# 계정 등급별 레이트 리밋이 있어, 같은 파일 재검사 방지와 사용자별 업로드 횟수 제한을 같이 둔다.
# 주의: 이미지 입력에서 sexual/minors는 판정되지 않는다(텍스트 전용) — sexual 점수로 성적 이미지 전체를 막는다.
# 비우면 업로드가 전부 거부된다(검사 실패 시 통과시키지 않는 fail-closed).
OPENAI_API_KEY=
