# 루트 .env 템플릿 — 실제 값을 채워 .env로 복사해서 사용 (.env는 git 무시됨)
# docker compose가 이 파일 하나를 읽어 모든 컨테이너에 값을 넣어준다.
# (컨테이너 없이 backend를 직접 돌릴 때도 spring-dotenv가 같은 파일을 읽는다)

# ===== Database =====
# 로컬(--profile local)은 컨테이너 이름으로, 배포는 RDS 엔드포인트로 붙는다.
#   배포 예: jdbc:postgresql://soksak-db.xxxxx.ap-northeast-2.rds.amazonaws.com:5432/soksak
DB_URL=jdbc:postgresql://postgres:5432/soksak
DB_USERNAME=postgres
# Postgres 비밀번호. 예: openssl rand -hex 32
DB_PASSWORD=

# ===== JWT =====
# 토큰 서명 키(HS256, 충분히 길게). 예: openssl rand -base64 32
JWT_SECRET_KEY=

# ===== 백엔드 → ai-server 내부 인증 =====
# 두 컨테이너가 같은 값을 봐야 한다(compose가 양쪽에 넣어준다).
# 예: openssl rand -hex 32
INTERNAL_AUTH_SECRET=

# ===== LLM (Vercel AI Gateway) =====
# ai-server 컨테이너에는 ai-server/.env 파일이 들어가지 않고 환경변수로만 값이 주입되므로,
# 이 두 값은 반드시 여기(루트 .env)에도 있어야 한다.
AI_GATEWAY_API_KEY=
AI_GATEWAY_BASE_URL=https://ai-gateway.vercel.sh/v1

# 요약 전용 모델/타임아웃. 둘 다 비워두면 코드 기본값(gpt-4o-mini, 60초)이 쓰인다.
# 요약은 대화 전송 때 답변 생성 '앞'에서 도니 싸고 빠른 모델을 쓴다 — 여기가 느리면
# 그만큼 답변 첫 토큰이 늦는다. 그래서 타임아웃도 채팅(60초)보다 짧게 잡는 걸 권장.
SUMMARY_MODEL=
SUMMARY_TIMEOUT=20

# ===== 토큰 수 세기 (벤더 직결) =====
# 요약을 저장할 때 그 요약이 몇 토큰인지 세어 두려는 용도. 세어 둔 값으로 "어느 청크까지
# 프롬프트에 실을지"를 정하므로, 매 턴 다시 세지 않아도 되게 생성 시점에 한 번만 부른다.
# 게이트웨이가 아니라 벤더 API를 직접 부르는 엔드포인트라 키가 따로 필요하다(둘 다 무료,
# 채팅 호출과 레이트 리밋도 별개).
#
# 필수. Anthropic /v1/messages/count_tokens 용.
ANTHROPIC_API_KEY=
# 선택. Gemini countTokens로 값을 비교해 볼 때만 쓴다. 안 쓰면 비워둬도 된다.
GOOGLE_API_KEY=

# 기준 토크나이저로 쓸 모델. 비워두면 코드 기본값(claude-opus-4-8).
# 카탈로그에서 토큰을 가장 많이 먹는 모델 하나로만 세어 두고 모든 방에 그 값을 쓴다.
# 다른 모델에선 실제보다 넉넉하게 잡히는데(= 과대추정), 컨텍스트가 터지는 쪽보다
# 조금 남기는 쪽이 안전해서 일부러 그렇게 둔다.
# 주의: 게이트웨이 slug(anthropic/claude-opus-4.8)가 아니라 Anthropic 직접 ID 표기다.
TOKEN_COUNT_MODEL=
